{
  "expo": {
    "name": "LeafScan AI",
    "slug": "leafscan-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LeafScan AI to select a leaf photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}